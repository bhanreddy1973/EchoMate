# =============================================================================
# EchoMate Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit Configuration (Required)
# -----------------------------------------------------------------------------

# LiveKit server URL (e.g., wss://your-app.livekit.cloud)
LIVEKIT_URL=wss://your-app.livekit.cloud

# LiveKit API credentials (obtain from LiveKit Cloud dashboard or self-hosted config)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# -----------------------------------------------------------------------------
# ASR Configuration (Required)
# -----------------------------------------------------------------------------

# Deepgram API key for speech-to-text (obtain from https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ASR model to use (optional, default: nova-2)
# DEEPGRAM_MODEL=nova-2

# Language for ASR (optional, default: en)
# DEEPGRAM_LANGUAGE=en

# -----------------------------------------------------------------------------
# TTS Configuration (Required)
# -----------------------------------------------------------------------------

# Cartesia API key for text-to-speech (obtain from https://play.cartesia.ai)
CARTESIA_API_KEY=your_cartesia_api_key

# Cartesia voice ID (optional, default: system default voice)
# CARTESIA_VOICE_ID=default

# TTS speech rate multiplier (optional, default: 1.0)
# CARTESIA_SPEED=1.0

# -----------------------------------------------------------------------------
# LLM Configuration (Required - at least one provider)
# -----------------------------------------------------------------------------

# NVIDIA NIM API key for Nemotron models (obtain from https://build.nvidia.com)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key

# OpenRouter API key for free models (obtain from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key

# Default model tier selection (optional, default: fast)
# Options: fast, reasoning
# LLM_DEFAULT_TIER=fast

# LLM request timeout in seconds (optional, default: 5)
# LLM_TIMEOUT_SECONDS=5

# Maximum fallback attempts on model failure (optional, default: 3)
# LLM_MAX_FALLBACK_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Memory Configuration (Optional)
# -----------------------------------------------------------------------------

# Directory for Chroma vector database persistence (optional, default: ./data/chroma)
# CHROMA_PERSIST_DIR=./data/chroma

# Short-term memory token limit (optional, default: 4000)
# SHORT_TERM_TOKEN_LIMIT=4000

# Number of long-term memory results to retrieve (optional, default: 5)
# LONG_TERM_TOP_K=5

# Minimum similarity score for memory retrieval (optional, default: 0.7)
# MIN_SIMILARITY_SCORE=0.7

# -----------------------------------------------------------------------------
# MCP Server Configuration (Optional)
# -----------------------------------------------------------------------------

# Path to MCP servers configuration file (optional, default: ./mcp_servers.json)
# MCP_SERVERS_CONFIG_PATH=./mcp_servers.json

# MCP server connection timeout in seconds (optional, default: 15)
# MCP_CONNECTION_TIMEOUT=15

# MCP tool call timeout in seconds (optional, default: 10)
# MCP_TOOL_CALL_TIMEOUT=10

# API keys for MCP servers (required if corresponding MCP server is enabled)
# WEATHER_API_KEY=your_weather_api_key
# GOOGLE_CREDENTIALS_PATH=./credentials/google-calendar.json
# TAVILY_API_KEY=your_tavily_api_key

# -----------------------------------------------------------------------------
# Voice Pipeline Configuration (Optional)
# -----------------------------------------------------------------------------

# Silence threshold in ms before triggering response (optional, default: 600, range: 200-2000)
# SILENCE_THRESHOLD_MS=600

# -----------------------------------------------------------------------------
# Application Configuration (Optional)
# -----------------------------------------------------------------------------

# Log level (optional, default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
