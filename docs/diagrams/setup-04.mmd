graph LR
    subgraph Required["Required to Start"]
        R1[LIVEKIT_URL]
        R2[LIVEKIT_API_KEY]
        R3[LIVEKIT_API_SECRET]
        R4[DEEPGRAM_API_KEY]
        R5[NVIDIA_NIM_API_KEY\nor OPENROUTER_API_KEY]
    end

    subgraph Voice["Voice Quality"]
        V1[CARTESIA_API_KEY]
        V2[CARTESIA_VOICE_ID]
        V3[CARTESIA_SPEED]
        V4[DEEPGRAM_MODEL — default: nova-2]
        V5[DEEPGRAM_LANGUAGE — default: en]
        V6[VOICE_LLM_MODEL — default: meta/llama-3.1-70b-instruct]
    end

    subgraph LLM["LLM Tuning"]
        L1[LLM_DEFAULT_TIER — fast or reasoning]
        L2[LLM_TIMEOUT_SECONDS — default: 5]
        L3[LLM_MAX_FALLBACK_ATTEMPTS — default: 3]
    end

    subgraph Memory["Memory"]
        M1[CHROMA_PERSIST_DIR — default: ./data/chroma]
        M2[SHORT_TERM_TOKEN_LIMIT — default: 4000]
        M3[LONG_TERM_TOP_K — default: 5]
        M4[MIN_SIMILARITY_SCORE — default: 0.7]
    end

    subgraph MCP["MCP"]
        MC1[MCP_SERVERS_CONFIG_PATH — default: ./mcp_servers.json]
        MC2[MCP_CONNECTION_TIMEOUT — default: 15s]
        MC3[MCP_TOOL_CALL_TIMEOUT — default: 10s]
        MC4[WEATHER_API_KEY]
        MC5[GOOGLE_CREDENTIALS_PATH]
        MC6[TAVILY_API_KEY]
    end

    subgraph Coding["Coding Workspace"]
        C1[JUDGE0_BASE_URL — default: http://localhost:2358]
        C2[JUDGE0_AUTH_TOKEN — optional]
        C3[OPENAI_API_KEY — optional for GPT-4o]
        C4[GEMINI_API_KEY — optional]
    end

    subgraph Advanced["Advanced"]
        A1[SILENCE_THRESHOLD_MS — default: 600]
        A2[LOG_LEVEL — DEBUG/INFO/WARNING/ERROR]
        A3[SSL_VERIFY — set false for dev behind proxy]
        A4[NVIDIA_INTEGRATE_API_KEY — for MiniMax/Mistral via NVIDIA]
        A5[NVIDIA_VOICECHAT_API_KEY — defaults to NIM key]
    end